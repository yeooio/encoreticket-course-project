<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.chenforegone.encoreticket.mapper.HallMapper">
    <update id="claimSchedule">
        UPDATE hall SET schedule_version = schedule_version + 1, update_time = UTC_TIMESTAMP()
        WHERE id = #{id} AND schedule_version = #{version}
    </update>
    <sql id="Filters">
        <where>
            <if test="q.hallNo != null">AND hall_no = #{q.hallNo}</if>
            <if test="q.hallName != null">AND hall_name LIKE #{q.namePattern} ESCAPE '!'</if>
            <if test="q.status != null">AND status = #{q.status}</if>
        </where>
    </sql>
    <select id="countFiltered" resultType="long">
        SELECT COUNT(*) FROM hall <include refid="Filters"/>
    </select>
    <select id="listFiltered" resultType="io.github.chenforegone.encoreticket.model.entity.Hall">
        SELECT * FROM hall <include refid="Filters"/> ORDER BY
        <choose><when test="q.sortBy == 'hallNo'">hall_no</when><when test="q.sortBy == 'hallName'">hall_name</when><otherwise>create_time</otherwise></choose>
        <choose><when test="q.sortOrder == 'asc'">ASC</when><otherwise>DESC</otherwise></choose>,
        id <choose><when test="q.sortOrder == 'asc'">ASC</when><otherwise>DESC</otherwise></choose>
        LIMIT #{limit} OFFSET #{offset}
    </select>
    <select id="seatCounts" resultType="io.github.chenforegone.encoreticket.mapper.HallMapper$SeatCounts">
        SELECT hall_id, COUNT(*) AS total, SUM(CASE WHEN status=0 THEN 1 ELSE 0 END) AS enabled
        FROM seat WHERE hall_id IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
        GROUP BY hall_id
    </select>
    <select id="hallsWithScreenings" resultType="long">
        SELECT DISTINCT hall_id FROM screening WHERE hall_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
</mapper>
