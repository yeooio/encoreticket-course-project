# Copy to .env and set three different passwords before the first startup.
# This file is read by both Docker Compose and Spring Boot as Java properties.
# Use unquoted alphanumeric values; random hexadecimal passwords are suitable.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_DATABASE=encore_ticket
MYSQL_USER=encore_ticket
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Flyway runs versioned migrations on application startup.
FLYWAY_ENABLED=true
# Set true only for a one-time existing-schema transition, then reset false.
FLYWAY_BASELINE_ON_MIGRATE=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
